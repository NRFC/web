# Production Dockerfile for Nginx
ARG WORDPRESS_BASE_IMAGE=wordpress:6.9-php8.4-fpm-alpine

FROM ${WORDPRESS_BASE_IMAGE} AS wordpress-core

FROM nginx:alpine

# Copy the WordPress core from the official image and overlay our site-specific content
COPY --from=wordpress-core /usr/src/wordpress/ /var/www/html/
COPY wordpress/wp-content/ /var/www/html/wp-content/
COPY wordpress/wp-config.php /var/www/html/wp-config.php
COPY wordpress/.htaccess /var/www/html/.htaccess

# Copy production Nginx configuration
COPY docker/production/nginx.conf /etc/nginx/conf.d/default.conf

# Prepare writable paths used by mounted volumes
RUN mkdir -p /var/www/html/wp-content/uploads && \
    chown -R nginx:nginx /var/www/html

WORKDIR /var/www/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

