{
  "name": "nrfc/nrfc-auto-links",
  "description": "NRFC Auto Links plugin test tooling",
  "type": "wordpress-plugin",
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "NRFC\\AutoLinks\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true
  }
}

