{
  "name": "nrfc/nrfc-sponsor-management",
  "description": "Unit testing tooling for the NRFC Sponsor Management plugin",
  "type": "wordpress-plugin",
  "autoload": {
    "psr-4": {
      "SponsorManagement\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload-dev": {
    "psr-4": {
      "NRFC\\SponsorManagement\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true
  }
}
