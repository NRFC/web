{
  "name": "nrfc/nrfc-match-reports",
  "description": "Unit testing tooling for the NRFC Match Reports plugin",
  "type": "wordpress-plugin",
  "require-dev": {
	"phpunit/phpunit": "^11.5"
  },
  "autoload-dev": {
	"psr-4": {
	  "NRFC\\MatchReports\\Tests\\": "tests/"
	}
  },
  "scripts": {
	"test": "phpunit --configuration phpunit.xml.dist"
  },
  "config": {
	"sort-packages": true
  }
}

