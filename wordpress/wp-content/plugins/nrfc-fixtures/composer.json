{
  "name": "nrfc/nrfc-fixtures",
  "description": "Unit testing tooling for the NRFC Fixtures plugin",
  "type": "wordpress-plugin",
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload-dev": {
    "psr-4": {
      "NRFC\\Fixtures\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true
  }
}

