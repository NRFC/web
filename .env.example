# Production Environment Variables
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# NEVER commit .env to version control!

# MySQL/MariaDB Configuration
# These should be STRONG, RANDOMLY GENERATED passwords
MARIADB_ROOT_PASSWORD=your-secure-root-password-here-change-me
WORDPRESS_PORT=8015
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=your-secure-wordpress-password-here-change-me
WORDPRESS_DB_NAME=wordpress

# WordPress authentication keys and salts (required in production)
# Generate with: ./bin/generate-wp-keys.sh
# Keep them stable between deploys, changing them logs every user out.
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=

# Production image tag to deploy (defaults to latest)
# WORDPRESS_IMAGE_TAG=latest

# WordPress Configuration
# These are typically inherited from wp-config.php but can be set here
# WORDPRESS_DEBUG=false
# WP_ENV=production

# Generate secure passwords with:
# openssl rand -base64 32

# Optional: Set timezone
# TZ=UTC

# Ignored in prod 
# Set user and group IDs for the container in development environments
UID=1001
GID=1001