# Production Environment Variables
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# NEVER commit .env to version control!

# MySQL/MariaDB Configuration
# These should be STRONG, RANDOMLY GENERATED passwords
MYSQL_ROOT_PASSWORD=your-secure-root-password-here-change-me
WORDPRESS_PORT=8015
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=your-secure-wordpress-password-here-change-me
WORDPRESS_DB_NAME=wordpress

# WordPress Configuration
# These are typically inherited from wp-config.php but can be set here
# WORDPRESS_DEBUG=false
# WP_ENV=production

# Generate secure passwords with:
# openssl rand -base64 32

# Optional: Set timezone
# TZ=UTC

# Ignored in prod 
# Set user and group IDs for the container in development environments
UID=1001
GID=1001